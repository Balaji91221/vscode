{
  "name": "samcode-ai-code-assistant",
  "displayName": "AI Code Assistant",
  "description": "AI-powered code assistant with chat, sidebar views, LSP support, and background task processing",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onChatParticipant:ai-assistant.chat"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai-assistant-container",
          "title": "AI Assistant",
          "icon": "resources/assistant-icon.svg"
        }
      ]
    },
    "views": {
      "ai-assistant-container": [
        {
          "id": "ai-assistant-suggestions",
          "name": "Code Suggestions",
          "type": "webview"
        },
        {
          "id": "ai-assistant-context",
          "name": "Context Analysis"
        }
      ]
    },
    "commands": [
      {
        "command": "ai-assistant.startAnalysis",
        "title": "AI Assistant: Start Code Analysis",
        "icon": "$(sparkle)"
      },
      {
        "command": "ai-assistant.refreshSuggestions",
        "title": "AI Assistant: Refresh Suggestions",
        "icon": "$(refresh)"
      },
      {
        "command": "ai-assistant.runInference",
        "title": "AI Assistant: Run Inference",
        "icon": "$(comment)"
      },
      {
        "command": "ai-assistant.chatInference",
        "title": "AI Assistant: Chat Inference",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "ai-assistant.moveToSecondary",
        "title": "AI Assistant: Move View to Secondary Sidebar",
        "icon": "$(arrow-small-right)"
      },
      {
        "command": "ai-assistant.clearContext",
        "title": "AI Assistant: Clear Context"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ai-assistant.refreshSuggestions",
          "when": "view == ai-assistant-suggestions",
          "group": "navigation"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "ai-assistant.chat",
        "name": "assistant",
        "description": "AI-powered coding assistant",
        "isSticky": true,
        "commands": [
          {
            "name": "explain",
            "description": "Explain selected code"
          },
          {
            "name": "refactor",
            "description": "Suggest refactoring improvements"
          },
          {
            "name": "fix",
            "description": "Fix code issues"
          },
          {
            "name": "optimize",
            "description": "Optimize code performance"
          },
          {
            "name": "test",
            "description": "Generate unit tests"
          }
        ]
      }
    ],
    "configuration": {
      "type": "object",
      "title": "AI Assistant",
      "properties": {
        "aiAssistant.openAI.apiKey": {
          "type": "string",
          "default": "",
          "description": "OpenAI API Key (sk-...); configure to enable OpenAI-based chat inference"
        },
        "aiAssistant.openAI.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "OpenAI model to use for chat inference"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.107.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.48.1",
    "eslint": "^9.39.1",
    "esbuild": "^0.27.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}